{
  "name": "hrps-data-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "varlock run -- next dev --webpack",
    "build": "varlock run -- next build --webpack",
    "start": "varlock run -- next start",
    "dev-local": "node scripts/local-db.mts dev",
    "local-db:up": "node scripts/local-db.mts up",
    "local-db:sync": "varlock run -- node scripts/local-db.mts sync",
    "local-db:down": "node scripts/local-db.mts down",
    "lint": "vp lint",
    "test": "playwright test",
    "test:unit": "vp test run --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vp test run --project storybook --coverage",
    "varlock-encrypt": "pnpm exec varlock encrypt --file .env.local",
    "prepare": "vp config",
    "dev:vinext": "CLOUDFLARE_BUILD=1 vp dev --config vite.cloudflare.config.ts --port 3001",
    "build:vinext": "CLOUDFLARE_BUILD=1 vp build --config vite.cloudflare.config.ts",
    "start:vinext": "CLOUDFLARE_BUILD=1 vp preview --config vite.cloudflare.config.ts",
    "preview:deploy": "CLOUDFLARE_BUILD=1 vinext-cloudflare previews deploy --vite-config vite.cloudflare.config.ts",
    "deploy:vinext": "CLOUDFLARE_BUILD=1 vinext-cloudflare deploy --vite-config vite.cloudflare.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@next/env": "16.0.5",
    "@types/pg": "^8.23.1",
    "@vinext/cloudflare": "^1.3.1",
    "@xstate/react": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "i18next": "^24.2.3",
    "i18next-resources-to-backend": "^1.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-i18n-router": "^5.5.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "^15.7.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-server-dom-webpack": "19.3.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "varlock": "^1.18.0",
    "vinext": "^1.4.1",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.10",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-coverage": "^3.0.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@storybook/react": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-playwright": "^2.2.2",
    "cf": "1.0.0-beta.27",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.0.5",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-css-modules": "^1.16.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react-leaflet-cluster": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-leaflet": "^5.0.0"
    },
    "multiselect-react-dropdown": {
      "react": "19.3.1",
      "react-dom": "19.3.1"
    }
  },
  "type": "module"
}
